# swarm.sh pane records, briefs and agent outputs, when run inside this repo.
.swarm/

# Local secrets and environments.
.env
.env.*
.venv/
.DS_Store
board/.obsidian/*
!board/.obsidian/app.json

# Python bytecode from bin/lib imports.
__pycache__/

# Go build outputs: go build ./... at the root writes ./swarm, scripts/build.sh writes dist/, and a git
# checkout's ported command builds into ./swarm.build-<pid> and renames it to ./swarm (bin/lib/binary.sh).
/swarm
/swarm.build-*
/dist/
