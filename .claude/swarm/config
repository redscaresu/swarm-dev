# swarm-dev builds itself: the board lives in board/, apart from the user docs in docs/.
board_dir = board
# The lead is a Claude session: dash puts what it can do in its own queue, apart from the user's.
lead = session
# The conductor merges its own green, reviewed PRs through swarm.sh merge (head pinned) and keeps going.
merge = agent
# One in four easy, low-risk code stories builds on Sonnet (user, 2026-10-22: run sonnet-share-on here,
# compare after 20 Sonnet builds). Stop early: two Sonnet builds in a row that miss a green, reviewed PR set it to 0.
sonnet_share = 4
# Review fallback when codex hits its usage limit (config-switch-ons, 2026-10-24).
fallback_reviewer = sonnet
# step-up hands a build to the next model on findings-3, ci-red-2, stalled or no-pr. The user agreed the Fable rung on 2026-10-21.
escalate_ladder = sonnet,opus,fable
# A green, mergeable PR waits this long for a review agent before it shows as queued. v0.28.0 retro
# (2026-10-26): at the default 30, green PRs sat up to 30 minutes before anyone noticed.
queue_minutes = 10
# Bedrock (2026-11-12): its bearer key and model pins reach agents only by name, unlike Foundry's.
# A session on a subscription or Foundry warns once per agent start that these are not set; that is harmless.
# Drop this line once the bedrock-env-passthrough story merges.
agent_env = AWS_BEARER_TOKEN_BEDROCK ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL
