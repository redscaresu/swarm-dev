filters:
  and:
    - file.ext == "md"
    - file.name != "README"
properties:
  note.status:
    displayName: Status
  note.epic:
    displayName: Epic
  note.depends_on:
    displayName: Depends on
  note.kind:
    displayName: Kind
  note.date:
    displayName: Started
views:
  - type: table
    name: Board
    filters:
      and:
        - file.inFolder("stories")
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - epic
      - depends_on
    columnSize:
      file.name: 252
  - type: table
    name: By epic
    filters:
      and:
        - file.inFolder("stories")
    groupBy:
      property: epic
      direction: ASC
    order:
      - file.name
      - status
      - depends_on
  - type: table
    name: Epics
    filters:
      and:
        - file.inFolder("epics")
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - depends_on
    columnSize:
      file.name: 280
  - type: table
    name: HLDs
    filters:
      and:
        - file.inFolder("hld")
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - date
      - status
  - type: table
    name: Waiting on you
    filters:
      and:
        - file.inFolder("stories")
        - kind == "lead"
    order:
      - file.name
      - status
      - epic
