{
  "description": "In a swarm project, a lone swarm.sh merge is the only command that merges a PR",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/merge-guard.sh\""
          }
        ]
      }
    ]
  }
}
