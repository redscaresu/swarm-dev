{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "How the swarm turns a design into merged PRs",
    "quality_profile": "showcase",
    "output": "docs/assets/swarm-flow.html",
    "animation": "trace"
  },
  "lanes": [
    {
      "id": "you",
      "label": "You"
    },
    {
      "id": "plan",
      "label": "Planning swarms"
    },
    {
      "id": "lead",
      "label": "Lead session (/swarm-dev:swarm)"
    },
    {
      "id": "build",
      "label": "Conductor, builders, review"
    }
  ],
  "phases": [
    {
      "id": "setup",
      "label": "Set up",
      "fromCol": 0,
      "toCol": 0
    },
    {
      "id": "planning",
      "label": "Design + plan",
      "fromCol": 1,
      "toCol": 2,
      "variant": "emphasis"
    },
    {
      "id": "building",
      "label": "Build + review",
      "fromCol": 3,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "hld",
    "swarm",
    "planhld",
    "epic",
    "planepic",
    "approve",
    "board",
    "conduct",
    "builders",
    "review",
    "merge"
  ],
  "nodes": [
    {
      "id": "init",
      "lane": "lead",
      "col": 0,
      "type": "backend",
      "label": "swarm.sh init",
      "sublabel": "first run, once",
      "width": 140
    },
    {
      "id": "hld",
      "lane": "you",
      "col": 0,
      "type": "external",
      "label": "/swarm-dev:hld",
      "sublabel": "write it with a co-author",
      "width": 140
    },
    {
      "id": "swarm",
      "lane": "lead",
      "col": 1,
      "type": "backend",
      "label": "/swarm-dev:swarm",
      "sublabel": "picks the next step",
      "width": 140
    },
    {
      "id": "planhld",
      "lane": "plan",
      "col": 1,
      "type": "messagebus",
      "label": "/plan-hld",
      "sublabel": "the HLD into epics",
      "width": 140
    },
    {
      "id": "epic",
      "lane": "you",
      "col": 1,
      "type": "external",
      "label": "/swarm-dev:epic",
      "sublabel": "agree each epic",
      "width": 140
    },
    {
      "id": "planepic",
      "lane": "plan",
      "col": 2,
      "type": "messagebus",
      "label": "/plan-epic",
      "sublabel": "stories, then critics",
      "width": 140
    },
    {
      "id": "approve",
      "lane": "you",
      "col": 3,
      "type": "security",
      "label": "Approve",
      "sublabel": "the stories",
      "width": 140
    },
    {
      "id": "board",
      "lane": "lead",
      "col": 3,
      "type": "database",
      "label": "The board",
      "sublabel": "HLDs, epics, stories",
      "width": 140
    },
    {
      "id": "leadstory",
      "lane": "you",
      "col": 4,
      "type": "security",
      "label": "Lead stories",
      "sublabel": "say go; do the You: steps",
      "width": 140
    },
    {
      "id": "conduct",
      "lane": "build",
      "col": 3,
      "type": "backend",
      "label": "Conductor",
      "sublabel": "one per epic",
      "width": 140
    },
    {
      "id": "builders",
      "lane": "build",
      "col": 4,
      "type": "backend",
      "label": "Builders",
      "sublabel": "one per story, own worktree",
      "width": 140
    },
    {
      "id": "watch",
      "lane": "lead",
      "col": 4,
      "type": "backend",
      "label": "swarm.sh wait --lead",
      "sublabel": "stuck, conflict, main red",
      "width": 140
    },
    {
      "id": "review",
      "lane": "build",
      "col": 5,
      "type": "security",
      "label": "Review agent",
      "sublabel": "with codex; capped at round 3",
      "width": 140
    },
    {
      "id": "merge",
      "lane": "you",
      "col": 5,
      "type": "security",
      "label": "Merge",
      "sublabel": "or the agent, with a grant",
      "width": 140
    }
  ],
  "edges": [
    {
      "id": "init-swarm",
      "from": "init",
      "to": "swarm",
      "label": "board ready"
    },
    {
      "id": "hld-agreed",
      "from": "hld",
      "to": "swarm",
      "label": "agreed",
      "variant": "emphasis"
    },
    {
      "id": "swarm-plan",
      "from": "swarm",
      "to": "planhld",
      "label": "plans it"
    },
    {
      "id": "epics",
      "from": "planhld",
      "to": "epic",
      "label": "epics"
    },
    {
      "id": "epic-agreed",
      "from": "epic",
      "to": "planepic",
      "label": "agreed",
      "variant": "emphasis"
    },
    {
      "id": "stories",
      "from": "planepic",
      "to": "approve",
      "label": "stories",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "written",
      "from": "approve",
      "to": "board",
      "label": "written"
    },
    {
      "id": "kind-lead",
      "from": "board",
      "to": "leadstory",
      "label": "kind: lead",
      "role": "branch",
      "variant": "dashed",
      "fromSide": "right",
      "toSide": "bottom"
    },
    {
      "id": "ready",
      "from": "board",
      "to": "conduct",
      "label": "ready"
    },
    {
      "id": "wave",
      "from": "conduct",
      "to": "builders",
      "label": "wave"
    },
    {
      "id": "pr",
      "from": "builders",
      "to": "review",
      "label": "PR"
    },
    {
      "id": "findings",
      "from": "review",
      "to": "builders",
      "label": "findings",
      "role": "return",
      "variant": "dashed",
      "route": "bottom-channel",
      "fromSide": "bottom",
      "toSide": "bottom"
    },
    {
      "id": "needs-lead",
      "from": "builders",
      "to": "watch",
      "label": "needs the lead",
      "role": "branch",
      "variant": "dashed"
    },
    {
      "id": "green",
      "from": "review",
      "to": "merge",
      "label": "green + reviewed",
      "variant": "emphasis"
    }
  ]
}
