{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "How the swarm builds a design",
    "quality_profile": "showcase",
    "output": "docs/assets/swarm-flow.html"
  },
  "lanes": [
    {
      "id": "you",
      "label": "You"
    },
    {
      "id": "lead",
      "label": "Lead session (/swarm-dev:swarm)"
    },
    {
      "id": "plan",
      "label": "Planning swarms"
    },
    {
      "id": "build",
      "label": "Conductor, builders, review"
    }
  ],
  "phases": [
    {
      "id": "design",
      "label": "Design",
      "fromCol": 0,
      "toCol": 0
    },
    {
      "id": "planning",
      "label": "Plan",
      "fromCol": 1,
      "toCol": 2,
      "variant": "emphasis"
    },
    {
      "id": "building",
      "label": "Build + review",
      "fromCol": 3,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "init",
    "epic",
    "swarm",
    "planepic",
    "approve",
    "board",
    "conduct",
    "builders",
    "review-agent"
  ],
  "nodes": [
    {
      "id": "epic",
      "lane": "you",
      "col": 0,
      "type": "external",
      "label": "/swarm-dev:epic",
      "sublabel": "write it with a co-author",
      "width": 140
    },
    {
      "id": "approve",
      "lane": "you",
      "col": 2,
      "type": "security",
      "label": "Approve",
      "sublabel": "the stories",
      "width": 140
    },
    {
      "id": "leadstory",
      "lane": "you",
      "col": 3,
      "type": "security",
      "label": "Lead stories",
      "sublabel": "say go; do the You: steps",
      "width": 140
    },
    {
      "id": "merge",
      "lane": "you",
      "col": 5,
      "type": "security",
      "label": "Merge",
      "sublabel": "or the conductor merges",
      "width": 140
    },
    {
      "id": "swarm",
      "lane": "lead",
      "col": 1,
      "type": "backend",
      "label": "/swarm-dev:swarm",
      "sublabel": "picks the next step",
      "width": 140
    },
    {
      "id": "board",
      "lane": "lead",
      "col": 3,
      "type": "database",
      "label": "The board",
      "sublabel": "docs/: epics, stories",
      "width": 140
    },
    {
      "id": "planepic",
      "lane": "plan",
      "col": 1,
      "type": "messagebus",
      "label": "/plan-epic",
      "sublabel": "stories + skeptics",
      "width": 140
    },
    {
      "id": "conduct",
      "lane": "build",
      "col": 3,
      "type": "backend",
      "label": "Conductor",
      "sublabel": "one per epic",
      "width": 140
    },
    {
      "id": "builders",
      "lane": "build",
      "col": 4,
      "type": "backend",
      "label": "Builders",
      "sublabel": "one per story, stackable",
      "width": 140
    },
    {
      "id": "review-agent",
      "lane": "build",
      "col": 5,
      "type": "security",
      "label": "Review agent",
      "sublabel": "with codex, one per PR",
      "width": 140
    },
    {
      "id": "init",
      "lane": "lead",
      "col": 0,
      "type": "backend",
      "label": "swarm.sh init",
      "sublabel": "once per project",
      "width": 140
    },
    {
      "id": "backlog",
      "lane": "plan",
      "col": 3,
      "type": "backend",
      "label": "Backlog conductor",
      "sublabel": "ready stories with no epic",
      "width": 140
    },
    {
      "id": "release",
      "lane": "lead",
      "col": 5,
      "type": "backend",
      "label": "Release",
      "sublabel": "lead cuts it",
      "width": 140
    }
  ],
  "edges": [
    {
      "id": "epic-agreed",
      "from": "epic",
      "to": "swarm",
      "label": "agreed",
      "variant": "emphasis"
    },
    {
      "id": "swarm-plan",
      "from": "swarm",
      "to": "planepic",
      "label": "plans it"
    },
    {
      "id": "stories",
      "from": "planepic",
      "to": "approve",
      "label": "stories"
    },
    {
      "id": "written",
      "from": "approve",
      "to": "board",
      "label": "written"
    },
    {
      "id": "kind-lead",
      "from": "board",
      "to": "leadstory",
      "label": "kind: lead",
      "role": "branch",
      "variant": "dashed"
    },
    {
      "id": "ready",
      "from": "board",
      "to": "conduct",
      "label": "ready"
    },
    {
      "id": "wave",
      "from": "conduct",
      "to": "builders",
      "label": "wave"
    },
    {
      "id": "pr",
      "from": "builders",
      "to": "review-agent",
      "label": "PR"
    },
    {
      "id": "findings",
      "from": "review-agent",
      "to": "builders",
      "label": "findings (tell)",
      "role": "return",
      "variant": "dashed",
      "route": "bottom-channel",
      "fromSide": "bottom",
      "toSide": "bottom"
    },
    {
      "id": "green",
      "from": "review-agent",
      "to": "merge",
      "label": "green + reviewed",
      "variant": "emphasis"
    },
    {
      "id": "merged",
      "from": "merge",
      "to": "board",
      "label": "next /swarm-dev:swarm readies what follows",
      "role": "return",
      "variant": "dashed"
    },
    {
      "id": "init-epic",
      "from": "init",
      "to": "epic",
      "label": "board ready"
    },
    {
      "id": "no-epic",
      "from": "board",
      "to": "backlog",
      "label": "no epic",
      "role": "branch",
      "variant": "dashed"
    },
    {
      "id": "backlog-wave",
      "from": "backlog",
      "to": "builders",
      "label": "wave",
      "role": "branch",
      "variant": "dashed"
    },
    {
      "id": "cut",
      "from": "merge",
      "to": "release",
      "label": "main has changes",
      "role": "branch",
      "variant": "dashed"
    }
  ]
}
