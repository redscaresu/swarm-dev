#!/usr/bin/env bash
# gh, as swarm.sh puts it first on its own PATH and every agent's: runs the real gh (the next gh on
# PATH outside any gh-shim folder) with the same arguments, stdin and exit code, then appends one line
# to SWARM_GH_LOG (unset: none): time; agent (SWARM_GH_CALLER, else SWARM_AGENT, else -); via
# (SWARM_GH_VIA, `swarm.sh <command>` when swarm.sh made the call, else -); the subcommand (`pr view`,
# `api graphql`, `api <path>` with each segment holding a digit as :id); the budget it spends (graphql
# or rest); many (paginate or watch for a run that spends many requests, else -); and the exit code.
# Nothing past the subcommand and the API path is logged, so no token, body or header; and a log that
# cannot be written never fails the call. flow's gh_calls section reads the log.
set -u

real=""
IFS=: read -r -a dirs <<< "${PATH}"
for d in ${dirs[@]+"${dirs[@]}"}; do
  # Every gh-shim folder, an older version's too, so two shims never call each other.
  [[ -n "${d}" && "${d%/}" != */gh-shim && -x "${d}/gh" && ! -d "${d}/gh" ]] || continue
  real="${d}/gh"; break
done
[[ -n "${real}" ]] || { echo "gh: command not found (no gh on PATH besides swarm-dev's gh-shim)" >&2; exit 127; }

# In the background with stdin kept, so a TERM, INT or HUP that lands here reaches gh too, not an
# orphan left holding the caller's pipe. A KILL cannot be trapped (a Python caller's timeout sends
# one): a watcher blocks on a pipe only this shim holds (gh starts before it opens), and when the pipe
# ends after the shim's `go` but without its `ok` (the shim killed) it ends gh. One process, no
# polling. A pipe that cannot open (a sandbox that refuses /dev/fd, as codex's does) never sends go,
# so its watcher leaves gh alone, and the call runs on without one.
"${real}" "$@" <&0 &
pid=$!
trap 'kill -TERM "${pid}" 2>/dev/null' TERM INT HUP
{ exec 3> >(exec > /dev/null 2>&1; read -r _ || exit 0; read -r ok || ok=""; [[ -n "${ok}" ]] || kill -TERM "${pid}"); } 2>/dev/null \
  && echo go 2>/dev/null >&3
wait "${pid}"; rc=$?
while kill -0 "${pid}" 2>/dev/null; do wait "${pid}"; rc=$?; done
trap - TERM INT HUP   # gh is done: a signal now ends the shim
echo ok 2>/dev/null >&3; exec 3>&-

[[ -n "${SWARM_GH_LOG:-}" ]] || exit "${rc}"

# word <arg>... — the first argument that is not a flag (-R/--repo's value skipped with it) as w ("?"
# when it is not a plain lowercase word, so no argument is logged), and in skip how many to shift
# past it. No $(...), so no fork.
word() {
  local a v=""
  w="?"; skip=0
  for a in "$@"; do
    skip=$((skip + 1))
    [[ -z "${v}" ]] || { v=""; continue; }
    case "${a}" in -R|--repo) v=1; continue ;; -*) continue ;; esac
    [[ ! "${a}" =~ ^[a-z][a-z-]*$ ]] || w="${a}"
    return
  done
}
many=-
for a in "$@"; do case "${a}" in --paginate) many=paginate ;; --watch) many=watch ;; esac; done
word "$@"; shift "${skip}"; sub="${w}" api=rest
case "${sub}" in
  api)
    path=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -X|--method|-H|--header|-f|--raw-field|-F|--field|--input|-q|--jq|-t|--template|--cache|--hostname|-p|--preview) shift 2 || break ;;   # a flag missing its value ends it
        -*) shift ;;
        *) path="$1"; break ;;
      esac
    done
    # A full URL (https://api.github.com/graphql, a GHES host's /api/v3/... or /api/graphql) as its path.
    if [[ "${path}" == *://* ]]; then
      path="${path#*://}"; path="${path#*/}"; path="${path#api/v3/}"; [[ "${path}" != api/graphql* ]] || path="${path#api/}"
    fi
    path="${path%%\?*}"; path="${path#/}"
    if [[ "${path}" == graphql ]]; then api=graphql
    elif [[ "${path}" =~ ^[A-Za-z0-9_.{}/-]+$ ]]; then
      IFS=/ read -r -a segs <<< "${path}"; path=""
      for s in ${segs[@]+"${segs[@]}"}; do [[ "${s}" != *[0-9]* ]] || s=":id"; path+="/${s}"; done
      path="${path#/}"
    else path="?"; fi
    sub="api ${path:-?}" ;;
  # ponytail: pr (but pr diff, a REST download), issue, repo, project, status and label list go
  # through GraphQL and the rest through REST, gh 2.x's split as a rule of thumb; a gh that moves one
  # shows as the wrong budget.
  status) api=graphql ;;
  pr|issue|repo|project|run|workflow|release|gist|auth|search|secret|variable|label|cache|codespace|config|extension|gpg-key|ssh-key|org|ruleset|attestation|alias)
    word "$@"; sub+=" ${w}"
    case "${sub}" in "pr diff") ;; pr\ *|issue\ *|repo\ *|project\ *|"label list") api=graphql ;; esac
    [[ "${sub}" != "run watch" ]] || many=watch ;;
esac
agent="${SWARM_GH_CALLER:-${SWARM_AGENT:--}}" via="${SWARM_GH_VIA:--}"
printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${agent//[$'\t\n\r']/ }" "${via//[$'\t\n\r']/ }" \
  "${sub}" "${api}" "${many}" "${rc}" 2>/dev/null >> "${SWARM_GH_LOG}"
exit "${rc}"
