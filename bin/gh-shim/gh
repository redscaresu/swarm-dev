#!/usr/bin/env bash
# gh, as swarm.sh puts it first on its own PATH and every agent's: runs the real gh (the next gh on
# PATH outside any gh-shim folder) with the same arguments, stdin and exit code, then appends one line
# to SWARM_GH_LOG (unset: none): time, caller (SWARM_GH_CALLER, else SWARM_AGENT, else -), the
# subcommand (`pr view`, `api graphql`, `api <path>` with each segment holding a digit as :id), the
# budget it spends (graphql or rest) and the exit code. Nothing past the subcommand and the API path
# is logged, so no token, body or header; and a log that cannot be written never fails the call.
# flow's gh_calls section reads the log.
set -u

real=""
IFS=: read -r -a dirs <<< "${PATH}"
for d in ${dirs[@]+"${dirs[@]}"}; do
  # Every gh-shim folder, an older version's too, so two shims never call each other.
  [[ -n "${d}" && "${d%/}" != */gh-shim && -x "${d}/gh" && ! -d "${d}/gh" ]] || continue
  real="${d}/gh"; break
done
[[ -n "${real}" ]] || { echo "gh: command not found (no gh on PATH besides swarm-dev's gh-shim)" >&2; exit 127; }

# In the background with stdin kept, so a TERM, INT or HUP that lands here reaches gh too, not an
# orphan left holding the caller's pipe. A KILL cannot be trapped (a Python caller's timeout sends
# one), so a watchdog, its stdio off the caller's pipes, ends gh within a second of the shim.
"${real}" "$@" <&0 &
pid=$!
trap 'kill -TERM "${pid}" 2>/dev/null' TERM INT HUP
(while kill -0 "$$" 2>/dev/null; do sleep 1; done; kill -TERM "${pid}" 2>/dev/null) < /dev/null > /dev/null 2>&1 &
dog=$!; disown "${dog}"   # so its end prints no "Terminated" on gh's stderr
wait "${pid}"; rc=$?
while kill -0 "${pid}" 2>/dev/null; do wait "${pid}"; rc=$?; done
trap - TERM INT HUP   # gh is done: a signal now ends the shim
kill "${dog}" 2>/dev/null

[[ -n "${SWARM_GH_LOG:-}" ]] || exit "${rc}"

# The subcommand: one word for a command without subcommands (or a user's alias), two for gh's
# command groups, and api's path, its query cut off, each segment holding a digit as :id.
word() { [[ "${1:-}" =~ ^[a-z][a-z-]*$ ]] && echo "$1" || echo "?"; }
# Flags before the command (gh -R o/r pr view) are skipped, -R's value with them.
while [[ "${1:-}" == -* ]]; do case "$1" in -R|--repo) shift 2 || break ;; *) shift ;; esac; done
sub="$(word "${1:-}")" api=rest
case "${sub}" in
  api)
    shift
    path=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -X|--method|-H|--header|-f|--raw-field|-F|--field|--input|-q|--jq|-t|--template|--cache|--hostname|-p|--preview) shift 2 || break ;;   # a flag missing its value ends it
        -*) shift ;;
        *) path="$1"; break ;;
      esac
    done
    path="${path%%\?*}"; path="${path#/}"
    if [[ "${path}" == graphql ]]; then api=graphql
    elif [[ "${path}" =~ ^[A-Za-z0-9_.{}/-]+$ ]]; then
      path="$(printf '%s\n' "${path}" | awk -F/ -v OFS=/ '{ for (i = 1; i <= NF; i++) if ($i ~ /[0-9]/) $i = ":id"; print }')"
    else path="?"; fi
    sub="api ${path:-?}" ;;
  # ponytail: pr (but pr diff, a REST download), issue, repo and project go through GraphQL and the
  # rest through REST, gh 2.x's split as a rule of thumb; a gh that moves one shows as the wrong budget.
  pr|issue|repo|project) sub+=" $(word "${2:-}")"; [[ "${sub}" == "pr diff" ]] || api=graphql ;;
  run|workflow|release|gist|auth|search|secret|variable|label|cache|codespace|config|extension|gpg-key|ssh-key|org|ruleset|attestation|alias)
    sub+=" $(word "${2:-}")" ;;
esac
caller="${SWARM_GH_CALLER:-${SWARM_AGENT:--}}"
printf '%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${caller//[$'\t\n\r']/ }" "${sub}" "${api}" "${rc}" 2>/dev/null >> "${SWARM_GH_LOG}"
exit "${rc}"
